{
  "name": "athlete-os-form",
  "version": "8.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "test:logic": "node scripts/check-logic.cjs",
    "catalog:fetch": "node scripts/fetch-exercises.mjs",
    "test:catalog": "node tests/test-catalog.cjs",
    "check": "npm run test:all && npm run typecheck",
    "test:syntax": "node scripts/check-project.mjs",
    "test:csv": "node tests/test-csv.cjs",
    "test:validation": "node tests/test-validation.cjs",
    "test:workout": "node tests/test-workout.cjs",
    "test:compat": "node tests/test-compat.cjs",
    "test:storage": "node tests/test-storage.cjs",
    "test:advanced": "node tests/test-advanced.cjs",
    "test:preflight": "node scripts/preflight.cjs",
    "test:form": "node tests/test-form.cjs",
    "test:deep": "node tests/test-form-deep.cjs",
    "test:all": "npm run test:preflight && npm run test:syntax && npm run test:logic && npm run test:catalog && npm run test:csv && npm run test:validation && npm run test:workout && npm run test:compat && npm run test:storage && npm run test:advanced && npm run test:form && npm run test:deep && npm run test:sqlite && npm run test:fresh",
    "test:sqlite": "node tests/test-relational.cjs",
    "test:fresh": "node tests/test-fresh.cjs"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "expo-linear-gradient": "~58.0.4",
    "expo-haptics": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-document-picker": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-modules-core": "^58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "expo-glass-effect": "~58.0.5",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
